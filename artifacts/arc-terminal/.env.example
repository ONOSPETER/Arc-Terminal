# Copy to .env for local dev. On Vercel add the same names in Project Settings -> Environment Variables.
# NEVER prefix these with VITE_ (that would ship them to the browser).

# --- OpenRouter (AI gateway) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional cheaper/different model for lesson writing (defaults to OPENROUTER_MODEL)
OPENROUTER_MODEL_LESSON=

# --- Tatum (Sui gRPC + Ethereum, Solana, and Base JSON-RPC) ---
# Sui mainnet gRPC: https://sui-mainnet-grpc.gateway.tatum.io
TATUM_API_KEY=
# Optional overrides if a gateway slug differs for your plan, e.g. TATUM_SLUG_BASE=base-mainnet
# TATUM_SLUG_ETHEREUM=ethereum-mainnet

# --- Walrus Memory (Sui Mainnet) ---
MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
MEMWAL_NAMESPACE=arc-terminal

# --- Optional protection for a public deployment ---
# If set, every API call (except /api/health) needs this passcode (the UI asks for it).
ARC_ACCESS_TOKEN=
